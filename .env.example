# Browser-safe (exposed to the client — restrict by referrer)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Server-only (Cloudflare Pages Functions and ingest jobs — never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
DATA_GOV_API_KEY=        # api.data.gov key, used for OpenFEC
GEOCODIO_API_KEY=
OPENAI_API_KEY=
LOOKUP_CHECK_TOKEN=      # Cloudflare Pages + GitHub secret: lets the nightly check run address lookups
